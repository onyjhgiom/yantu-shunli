/**
 * 全局样式 · 暗夜金主题
 * 近黑冷调底 + 冷蓝灰卡片 + 琥珀金强调色
 * 所有颜色以 CSS 变量统一管理，禁止外部 CDN / 字体
 */

/* ============================================================
 * 主题系统 · 4 套皮肤（.th-light / .th-dark / .th-ocean / .th-sakura）
 * 页面根节点挂对应 class 即切换整套配色，WXSS 内只引用变量。
 * page{} 保留「暖灰·森林绿（浅色）」作为兜底默认值，确保任何未挂主题
 * class 的节点也不会出现不可读配色。所有色值以 CSS 变量统一管理。
 * ============================================================ */
page {
  /* —— 兜底默认（浅色·森林绿），与 .th-light 一致 —— */
  --paper: #F4F1E9;          /* 暖灰纸张底 */
  --paper-deep: #EDE8DC;     /* 稍深的纸色 */
  --card: #FBF9F3;           /* 卡片纸 */
  --card-line: #E6E0D2;      /* 卡片描边 */
  --ink: #2B2B28;            /* 主文字（暖黑） */
  --ink-soft: #57534A;       /* 次级文字 */
  --sub: #8C877B;            /* 弱化文字 */
  --line: #E4DFD2;           /* 分隔线 */

  --forest: #2E4F3E;         /* 深森林绿 · 主色 */
  --forest-deep: #233E31;
  --forest-soft: #E4ECE6;    /* 绿色浅底 */
  --terracotta: #C2703D;     /* 陶土橙 · 点缀 */
  --terracotta-soft: #F5E7DC;
  --terracotta-line: #E0CBB8;

  --ok: #5B8C5A;
  --warn: #A87A28;
  --danger: #B5532E;
  --danger-soft: #F2E2DA;
  --warn-soft: #F3ECDD;

  /* 学科色 */
  --c-politics: #B5532E;
  --c-english: #2E6E8E;
  --c-math: #C2703D;
  --c-major: #3E6B4F;

  --on-primary: #F4F1E9;                     /* 主色上的文字（浅色主题里主色深，用浅字） */
  --paper-fade: rgba(244, 241, 233, 0);      /* 页面底色的透明版（吸底栏渐变末端） */
  --primary-glow: rgba(46, 79, 62, 0.16);    /* 主色投影 / 光晕 */
  --scrim: rgba(0, 0, 0, 0.55);            /* 弹层遮罩（跨主题通用） */
  --shadow: rgba(0, 0, 0, 0.28);           /* 卡片投影（跨主题通用） */

  /* 跨主题通用文字色：--on-dark 用于重色块（驾驶舱/倒计时）上的浅字；
   * --on-color 用于饱和强调色（徽标/勾选）上的浅字；均随主题恒定。 */
  --on-dark: #F2F0EB;
  --on-dark-rgb: 242, 240, 235;
  --on-color: #FFFFFF;
  /* 饱和填充（主色以外的 ok / danger / warn / terracotta / 学科色）上的文字色。
   * 四套皮肤里这些色的明暗不同步，不能共用一个「白字」，故单独给一个变量。 */
  --on-fill: #FFFFFF;
  /* 同上两个的通道版，供 rgba(var(--x-rgb), α) 组半透明色用 */
  --on-primary-rgb: 244, 241, 233;
  --primary-rgb: 46, 79, 62;

  /* 图表用（JS 内联 style 引用；Canvas 则取 utils/theme.js 的 palette 真值） */
  --chart-area: rgba(46, 79, 62, 0.08);
  --heat-0: #EDE8DC; --heat-1: #CFE0D2; --heat-2: #9FC0A8; --heat-3: #5B8C5A; --heat-4: #2E4F3E;
  --heat-line: #E4DFD2;

  --radius: 16rpx;
  --radius-lg: 24rpx;
  --radius-btn: 14rpx;

  background-color: var(--paper);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}

/* ---------- 主题 1：暖灰·森林绿（浅色，原 Editorial） ---------- */
.th-light {
  --paper: #F4F1E9; --paper-deep: #EDE8DC; --card: #FBF9F3; --card-line: #E6E0D2;
  --ink: #2B2B28; --ink-soft: #57534A; --sub: #8C877B; --line: #E4DFD2;
  --forest: #2E4F3E; --forest-deep: #233E31; --forest-soft: #E4ECE6;
  --terracotta: #C2703D; --terracotta-soft: #F5E7DC; --terracotta-line: #E0CBB8;
  --ok: #5B8C5A; --warn: #A87A28; --danger: #B5532E; --danger-soft: #F2E2DA; --warn-soft: #F3ECDD;
  --c-politics: #B5532E; --c-english: #2E6E8E; --c-math: #C2703D; --c-major: #3E6B4F;
  --on-primary: #F4F1E9; --on-fill: #FFFFFF; --on-primary-rgb: 244, 241, 233; --primary-rgb: 46, 79, 62; --paper-fade: rgba(244, 241, 233, 0); --primary-glow: rgba(46, 79, 62, 0.16);
  --chart-area: rgba(46, 79, 62, 0.08);
  --heat-0: #EDE8DC; --heat-1: #CFE0D2; --heat-2: #9FC0A8; --heat-3: #5B8C5A; --heat-4: #2E4F3E; --heat-line: #E4DFD2;
}

/* ---------- 主题 2：暗夜·金（深色） ---------- */
.th-dark {
  --paper: #0B0E14; --paper-deep: #0E131B; --card: #1B222E; --card-line: #2A3342;
  --ink: #F2F0EB; --ink-soft: #A8A59D; --sub: #8A867C; --line: #232A35;
  --forest: #E0A94A; --forest-deep: #E8B75E; --forest-soft: #2A2418;
  --terracotta: #E8B75E; --terracotta-soft: #2E2619; --terracotta-line: #4A3C24;
  --ok: #5FA86B; --warn: #D9A441; --danger: #D9614A; --danger-soft: #2E1A16; --warn-soft: #2B2415;
  --c-politics: #D9614A; --c-english: #5B9BD5; --c-math: #E0A94A; --c-major: #5FA86B;
  --on-primary: #141008; --on-fill: #141008; --on-primary-rgb: 20, 16, 8; --primary-rgb: 224, 169, 74; --paper-fade: rgba(11, 14, 20, 0); --primary-glow: rgba(224, 169, 74, 0.30);
  --chart-area: rgba(224, 169, 74, 0.12);
  --heat-0: #232A35; --heat-1: #3A3527; --heat-2: #6B5527; --heat-3: #A88338; --heat-4: #E0A94A; --heat-line: #2A3342;
}

/* ---------- 主题 3：暗夜·深海蓝（深色，青色强调） ---------- */
.th-ocean {
  --paper: #0A1014; --paper-deep: #0E161B; --card: #16242B; --card-line: #24414B;
  --ink: #EAF2F4; --ink-soft: #9FB8BE; --sub: #7E9AA1; --line: #1E3038;
  --forest: #3FB6C9; --forest-deep: #5FD0E0; --forest-soft: #16323A;
  --terracotta: #54C7B8; --terracotta-soft: #163A33; --terracotta-line: #2C5A50;
  --ok: #5FBF8A; --warn: #E0B85C; --danger: #E5705B; --danger-soft: #2E1A16; --warn-soft: #2B2415;
  --c-politics: #E5705B; --c-english: #5B9BD5; --c-math: #3FB6C9; --c-major: #5FBF8A;
  --on-primary: #04161A; --on-fill: #04161A; --on-primary-rgb: 4, 22, 26; --primary-rgb: 63, 182, 201; --paper-fade: rgba(10, 16, 20, 0); --primary-glow: rgba(63, 182, 201, 0.30);
  --chart-area: rgba(63, 182, 201, 0.14);
  --heat-0: #1E3038; --heat-1: #1D3C42; --heat-2: #2A6067; --heat-3: #3A8E9C; --heat-4: #3FB6C9; --heat-line: #24414B;
}

/* ---------- 主题 4：晨雾·樱粉（浅色，玫瑰强调） ---------- */
.th-sakura {
  --paper: #FBF2F5; --paper-deep: #F4E6EC; --card: #FFFFFF; --card-line: #F0DDE5;
  --ink: #33282C; --ink-soft: #6E5B62; --sub: #9A8590; --line: #EFDCE4;
  --forest: #B8557C; --forest-deep: #9E4569; --forest-soft: #F7E6EC;
  --terracotta: #D98BA8; --terracotta-soft: #FBEAEF; --terracotta-line: #EAC6D4;
  --ok: #6FAE72; --warn: #D6A24B; --danger: #C75A6B; --danger-soft: #F7E2E6; --warn-soft: #F6ECDC;
  --c-politics: #C75A6B; --c-english: #5B8FBF; --c-math: #C45B86; --c-major: #6FAE72;
  --on-primary: #FBF2F5; --on-fill: #33282C; --on-primary-rgb: 251, 242, 245; --primary-rgb: 184, 85, 124; --paper-fade: rgba(251, 242, 245, 0); --primary-glow: rgba(184, 85, 124, 0.20);
  --chart-area: rgba(196, 91, 134, 0.10);
  --heat-0: #F4E6EC; --heat-1: #F0D2DE; --heat-2: #DEA6BC; --heat-3: #C45B86; --heat-4: #A8466F; --heat-line: #F0DDE5;
}

/* ---------- 重色块（驾驶舱 / 倒计时 / 专注入口等）专用深色表面 ----------
 * 浅色主题用「深主色」渐变（森林绿 / 玫瑰），深色主题用中性深色渐变；
 * 文字统一用 --on-dark（浅字），故无论哪套皮肤，重色块都稳定可读。 */
.th-light, .th-sakura {
  --surface-dark: radial-gradient(120% 96% at 82% 0%, var(--primary-glow) 0%, rgba(0, 0, 0, 0) 62%),
                  linear-gradient(160deg, var(--forest-deep) 0%, var(--forest) 100%);
}
.th-dark, .th-ocean {
  --surface-dark: radial-gradient(120% 96% at 82% 0%, var(--primary-glow) 0%, rgba(0, 0, 0, 0) 62%),
                  linear-gradient(160deg, var(--card) 0%, var(--paper-deep) 100%);
}

/* 衬线字体：用于 Editorial 风格的标题与数字 */
.serif {
  font-family: "Songti SC", "STSong", "SimSun", "Times New Roman", serif;
}

.page {
  min-height: 100vh;
  padding: 32rpx 32rpx 60rpx;
  box-sizing: border-box;
  background-color: var(--paper);
  color: var(--ink);
}

.page--tight { padding-bottom: 140rpx; }

/* ---------- 卡片 ---------- */
.card {
  background: var(--card);
  border: 1rpx solid var(--card-line);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-sizing: border-box;
}
.card + .card { margin-top: 24rpx; }

.card__title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 0.5rpx;
}
.card__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.card__more {
  font-size: 24rpx;
  color: var(--sub);
}

/* ---------- 排版 ---------- */
.h1 { font-size: 52rpx; font-weight: 700; letter-spacing: 1rpx; color: var(--ink); }
.h2 { font-size: 38rpx; font-weight: 700; letter-spacing: 0.5rpx; color: var(--ink); }
.h3 { font-size: 32rpx; font-weight: 600; color: var(--ink); }
.muted { color: var(--sub); font-size: 24rpx; }
.soft { color: var(--ink-soft); }
.num {
  font-family: "Songti SC", "STSong", serif;
  font-weight: 700;
  color: var(--forest);
}

.divider { height: 1rpx; background: var(--line); margin: 24rpx 0; }

/* ---------- 布局 ---------- */
.row { display: flex; align-items: center; }
.row--between { justify-content: space-between; }
.col { display: flex; flex-direction: column; }
.grow { flex: 1; }
.wrap { flex-wrap: wrap; }
.gap8 { gap: 8rpx; }
.gap12 { gap: 12rpx; }
.gap16 { gap: 16rpx; }
.gap20 { gap: 20rpx; }

/* ---------- 按钮 ---------- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  padding: 0 36rpx;
  /* 必须写：小程序 button 内置样式是 border-box，而 <view class="btn"> 默认是 content-box。
     不统一会导致 width:100% 的按钮右侧被 padding 顶出去（比卡片宽 36rpx）。 */
  box-sizing: border-box;
  border-radius: var(--radius-btn);
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  line-height: 1;
}
.btn::after { border: none; }
.btn--primary { background: var(--forest); color: var(--on-primary); }
.btn--accent { background: var(--terracotta); color: var(--on-fill); }
.btn--ghost {
  background: transparent;
  color: var(--forest);
  border: 1rpx solid var(--forest);
}
.btn--soft { background: var(--forest-soft); color: var(--forest-deep); }
/* ⚠️ 这里必须带 !important，否则「整行按钮」在小程序里永远做不出来：
   微信内置样式里有一条 button:not([size="mini"]) { width: 184px; }
   它的选择器权重 (0,2,1) 高于我们的单类名 (0,1,0)，
   于是 <button class="btn btn--block"> 的 width:100% 会被静默顶掉 ——
   按钮固定 184px 宽、靠左显示（≈屏宽的一半），看着就像"跑到左下角"。
   用 !important 才能压过内置样式（不要删！删了按钮会重新变窄变歪）。
   注：<view class="btn btn--block"> 不受影响，但也一起受益于这条统一规则。 */
.btn--block { width: 100% !important; }
.btn--sm { height: 64rpx; padding: 0 24rpx; font-size: 24rpx; border-radius: 12rpx; }
.btn[disabled] { opacity: 0.45; }

/* ---------- 标签 ---------- */
.tag {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 18rpx;
  border-radius: 22rpx;
  font-size: 22rpx;
  line-height: 1;
  background: var(--forest-soft);
  color: var(--forest-deep);
}
.tag--accent { background: var(--terracotta-soft); color: var(--terracotta); }
.tag--line { background: transparent; border: 1rpx solid var(--line); color: var(--ink-soft); }

/* ---------- 表单 ---------- */
.field { padding: 24rpx 0; border-bottom: 1rpx solid var(--line); }
.field:last-child { border-bottom: none; }
.field__label { font-size: 26rpx; color: var(--ink-soft); margin-bottom: 12rpx; }
.input {
  width: 100%;
  height: 72rpx;
  font-size: 30rpx;
  color: var(--ink);
  background: transparent;
}
.input-box {
  background: var(--paper-deep);
  border-radius: 12rpx;
  padding: 0 24rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
}
.textarea-box {
  background: var(--paper-deep);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  min-height: 180rpx;
  font-size: 28rpx;
  color: var(--ink);
  width: 100%;
  box-sizing: border-box;
}
.ph { color: var(--sub); }

/* ---------- 悬浮按钮 ---------- */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 104rpx;
  height: 104rpx;
  border-radius: 52rpx;
  background: var(--forest);
  color: var(--on-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  line-height: 1;
  box-shadow: 0 12rpx 30rpx var(--primary-glow);
  z-index: 20;
}

/* ---------- 安全区 ---------- */
.safe-bottom { padding-bottom: env(safe-area-inset-bottom); }

/* ---------- 功能宫格（首页 / 我的 / 资料 共用） ---------- */
.grid { display: flex; flex-wrap: wrap; }
.grid__item {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 26rpx 0;
  position: relative;
}
.grid__icon { font-size: 40rpx; color: var(--forest); }
.grid__label { font-size: 24rpx; color: var(--ink-soft); margin-top: 10rpx; }
.grid__badge {
  position: absolute;
  top: 16rpx;
  left: 50%;
  margin-left: 20rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 15rpx;
  background: var(--terracotta);
  color: var(--on-fill);
  font-size: 20rpx;
  line-height: 30rpx;
  text-align: center;
  box-sizing: border-box;
}

/* 交互反馈：常见可点元素的按下态（轻微变暗，提升点击触感） */
.btn:active, .act:active, .grid__item:active, .rate__btn:active,
.rec__item:active, .o:active, .picker:active, .card__more:active {
  opacity: .82;
}
