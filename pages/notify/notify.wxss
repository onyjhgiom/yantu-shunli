.head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.head__l { display: flex; align-items: baseline; }
.head__t { font-size: 44rpx; font-weight: 700; color: var(--ink); }
.head__u { font-size: 24rpx; color: var(--terracotta); margin-left: 16rpx; }
.head__r { display: flex; gap: 24rpx; }
.head__btn { font-size: 26rpx; color: var(--forest); }

.nf {
  display: flex; align-items: flex-start; background: var(--card);
  border: 1rpx solid var(--card-line); border-radius: var(--radius-lg);
  padding: 24rpx; margin-bottom: 16rpx;
}
.nf.unread { border-left: 8rpx solid var(--terracotta); }
.nf__icon {
  width: 64rpx; height: 64rpx; border-radius: 32rpx; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  color: var(--on-primary); font-size: 32rpx; margin-right: 20rpx;
}
.nf__body { flex: 1; min-width: 0; }
.nf__top { display: flex; align-items: baseline; justify-content: space-between; }
.nf__title { font-size: 28rpx; font-weight: 600; color: var(--ink); }
.nf__date { font-size: 22rpx; color: var(--sub); }
.nf__content { display: block; font-size: 26rpx; color: var(--ink-soft); margin-top: 8rpx; line-height: 1.5; }
.nf__type { display: inline-block; font-size: 20rpx; color: var(--sub); margin-top: 10rpx; background: var(--paper-deep); border-radius: 8rpx; padding: 2rpx 12rpx; }
.nf__del { flex-shrink: 0; width: 56rpx; text-align: center; font-size: 30rpx; color: var(--sub); }
