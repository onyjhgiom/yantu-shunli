.page { padding: 32rpx 32rpx 60rpx; box-sizing: border-box; }

.topbar { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 12rpx; }
.topbar__mode { font-size: 26rpx; color: var(--c-english); font-weight: 600; }
.topbar__progress { font-size: 26rpx; color: var(--sub); }
.progress-line { height: 8rpx; background: var(--paper-deep); border-radius: 4rpx; overflow: hidden; margin-bottom: 24rpx; }
.progress-line__fill { height: 100%; background: var(--c-english); border-radius: 4rpx; transition: width .25s; }

.flash { padding: 40rpx 32rpx; }
.flash__prompt { font-size: 52rpx; font-weight: 700; color: var(--ink); text-align: center; word-break: break-all; }

.opts { margin-top: 36rpx; display: flex; flex-direction: column; gap: 18rpx; }
.opt {
  padding: 26rpx 28rpx; border-radius: 14rpx; background: var(--paper-deep);
  font-size: 28rpx; color: var(--ink); border: 1rpx solid transparent;
}
.opt--ok { background: var(--forest-soft); border-color: var(--ok); color: var(--forest-deep); }
.opt--bad { background: var(--danger-soft); border-color: var(--danger); color: var(--danger); }

.spell { margin-top: 36rpx; }
.spell__input { height: 88rpx; background: var(--paper-deep); border-radius: 14rpx; padding: 0 24rpx; font-size: 32rpx; }
.spell__btn { margin-top: 24rpx; }

.answer { margin-top: 36rpx; padding-top: 28rpx; border-top: 1rpx solid var(--line); }
.answer__head { display: flex; align-items: baseline; gap: 16rpx; }
.answer__word { font-size: 40rpx; font-weight: 700; color: var(--ink); }
.answer__ph { font-size: 24rpx; color: var(--sub); }
.answer__tag { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 14rpx; margin-left: auto; }
.answer__tag--ok { background: var(--forest-soft); color: var(--forest-deep); }
.answer__tag--bad { background: var(--danger-soft); color: var(--danger); }
.answer__meaning { font-size: 28rpx; color: var(--ink-soft); display: block; margin-top: 16rpx; }
.answer__example, .answer__roots { font-size: 24rpx; color: var(--sub); display: block; margin-top: 12rpx; line-height: 1.6; }
.answer__next { margin-top: 30rpx; }

/* 完成态 */
.done { text-align: center; padding: 60rpx 32rpx; }
.done__title { font-size: 44rpx; font-weight: 700; color: var(--ink); }
.done__stat { font-size: 30rpx; color: var(--ink-soft); margin: 24rpx 0; }
.done__num { color: var(--c-english); font-size: 38rpx; }
.done__btns { display: flex; gap: 16rpx; margin-top: 30rpx; }
.done__btns .btn { flex: 1; }
.muted { color: var(--sub); font-size: 24rpx; }
