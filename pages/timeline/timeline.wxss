/* 考研日历 —— 月历 / 阶段指引 / 招生季时间轴 */

/* 顶部倒计时 */
.tl-cd { display: flex; align-items: baseline; gap: 8rpx; margin-top: 10rpx; }
.tl-cd__num { font-size: 56rpx; color: var(--on-dark); font-weight: 600; line-height: 1; }
.tl-cd__unit { font-size: 24rpx; color: rgba(var(--on-dark-rgb), 0.72); }
.tl-cd--empty .tl-cd__unit { font-size: 24rpx; }

/* 当前阶段卡 */
.ph { margin-top: 20rpx; border-left: 6rpx solid var(--terracotta); }
.ph__top { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 12rpx; }
.ph__name { font-size: 34rpx; font-weight: 600; color: var(--ink); }
.ph__range { font-size: 22rpx; color: var(--sub); }
.ph__focus { display: flex; gap: 8rpx; margin-top: 8rpx; }
.ph__bullet { color: var(--terracotta); font-size: 26rpx; line-height: 1.5; }
.ph__txt { flex: 1; font-size: 25rpx; color: var(--ink); line-height: 1.55; }
.ph__watch { margin-top: 14rpx; font-size: 23rpx; color: var(--sub); background: var(--paper); border-radius: 10rpx; padding: 12rpx 16rpx; line-height: 1.5; }
.ph__next { margin-top: 12rpx; font-size: 23rpx; color: var(--forest); }

/* 月历 */
.cal { margin-top: 20rpx; }
.cal__bar { display: flex; align-items: center; gap: 14rpx; margin-bottom: 18rpx; }
.cal__nav { width: 52rpx; height: 52rpx; border-radius: 50%; background: var(--paper); color: var(--ink); font-size: 32rpx; line-height: 52rpx; text-align: center; flex-shrink: 0; }
.cal__label { flex: 1; text-align: center; font-size: 30rpx; font-weight: 600; color: var(--ink); }
.cal__today { font-size: 23rpx; color: var(--forest); background: var(--paper); border-radius: 999rpx; padding: 10rpx 20rpx; flex-shrink: 0; }

.cal__head { display: flex; margin-bottom: 6rpx; }
.cal__hcell { flex: 1; text-align: center; font-size: 22rpx; color: var(--sub); }

.cal__row { display: flex; }
.cal__cell { flex: 1; height: 86rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; border-radius: 12rpx; }
.cal__cell--void { visibility: hidden; }
.cal__d { font-size: 26rpx; color: var(--ink); line-height: 1.1; }
.cal__cell.is-weekend .cal__d { color: var(--sub); }
.cal__cell.is-today { background: var(--forest); }
.cal__cell.is-today .cal__d { color: var(--on-primary); font-weight: 600; }
/* 有节点的日子给一点底色，扫一眼就能看出哪天有事 */
.cal__cell.has-mark { background: var(--paper); }
.cal__dot { width: 8rpx; height: 8rpx; border-radius: 50%; background: var(--terracotta); margin-top: 4rpx; }
.cal__cell.is-today .cal__dot { background: var(--on-primary); }
.cal__lv { width: 30rpx; height: 6rpx; border-radius: 3rpx; margin-top: 4rpx; }
.lv1 { background: var(--heat-1); }
.lv2 { background: var(--heat-2); }
.lv3 { background: var(--heat-3); }
.lv4 { background: var(--forest); }

.cal__foot { margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid var(--line); font-size: 23rpx; color: var(--sub); text-align: center; }
.cal__strong { color: var(--forest); font-weight: 600; }

/* 选中日详情 */
.det { margin-top: 20rpx; border-left: 6rpx solid var(--forest); }
.det__head { display: flex; align-items: baseline; gap: 14rpx; flex-wrap: wrap; }
.det__date { font-size: 26rpx; color: var(--sub); }
.det__title { font-size: 28rpx; font-weight: 600; color: var(--ink); flex: 1; }
.det__line { font-size: 24rpx; color: var(--ink); line-height: 1.6; margin-top: 8rpx; }
.det__tip { font-size: 22rpx; color: var(--sub); margin-top: 12rpx; }

/* 全国招生季 */
.sec__t { font-size: 30rpx; font-weight: 600; color: var(--ink); }
.sec__s { font-size: 22rpx; color: var(--sub); margin-top: 6rpx; margin-bottom: 16rpx; }

.sn { display: flex; align-items: flex-start; padding: 14rpx 0; }
.sn__dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: var(--line); margin: 10rpx 20rpx 0 6rpx; flex-shrink: 0; }
.sn__dot.now { background: var(--terracotta); box-shadow: 0 0 0 6rpx var(--terracotta-soft); }
.sn__dot.done { background: var(--line); }
.sn__body { flex: 1; border-bottom: 1rpx solid var(--line); padding-bottom: 14rpx; }
.sn__top { display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; }
.sn__title { font-size: 27rpx; color: var(--ink); font-weight: 500; }
.sn__month { font-size: 22rpx; color: var(--sub); }
.sn__state { font-size: 20rpx; color: var(--on-fill); background: var(--terracotta); border-radius: 999rpx; padding: 2rpx 12rpx; }
.sn__desc { font-size: 23rpx; color: var(--sub); line-height: 1.55; margin-top: 8rpx; }
.sn__caret { font-size: 22rpx; color: var(--sub); align-self: center; }

/* 我的时间线（沿用原有样式） */
.tl-node { display: flex; align-items: stretch; padding: 18rpx 0; }
.tl-node__dot { width: 20rpx; height: 20rpx; border-radius: 50%; background: var(--forest); margin: 10rpx 24rpx 0 8rpx; flex-shrink: 0; }
.tl-node.soon .tl-node__dot { background: var(--terracotta); box-shadow: 0 0 0 6rpx var(--terracotta-soft); }
.tl-node.past .tl-node__dot { background: var(--line); }
.tl-node__body { flex: 1; border-bottom: 1rpx solid var(--line); padding-bottom: 18rpx; }
.tl-node__top { display: flex; align-items: center; justify-content: space-between; }
.tl-node__label { font-size: 30rpx; font-weight: 600; color: var(--ink); }
.tl-node__days { font-size: 24rpx; color: var(--forest); }
.tl-node.soon .tl-node__days { color: var(--terracotta); }
.tl-node.past .tl-node__days, .tl-node.past .tl-node__label { color: var(--sub); }
.tl-node__date { font-size: 22rpx; color: var(--sub); display: block; margin-top: 6rpx; }

.btn--soft.btn--sm { margin-top: 20rpx; }

.disclaimer { font-size: 20rpx; color: var(--sub); text-align: center; margin: 20rpx 0 8rpx; line-height: 1.6; }

/* ===== 法定节假日 / 调休标注 ===== */
.cal__hol {
  position: absolute; top: 3rpx; right: 3rpx;
  font-size: 16rpx; line-height: 1; padding: 3rpx 5rpx; border-radius: 5rpx; font-weight: 600;
}
.cal__hol.holiday { background: var(--danger-soft); color: var(--danger); }
.cal__hol.work { background: var(--forest-soft); color: var(--forest-deep); }
/* 法定假日：日号用主色强调；调休上班：日号加重，取消周末淡色 */
.cal__cell.is-rest .cal__d { color: var(--danger); font-weight: 600; }
.cal__cell.is-work .cal__d { color: var(--ink); font-weight: 600; }
.cal__cell.is-work { background: var(--forest-soft); }
.cal__cell.is-today .cal__d { color: var(--on-primary); }

.cal__legend {
  display: flex; flex-wrap: wrap; gap: 24rpx;
  margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid var(--line);
}
.cal__lg { display: flex; align-items: center; gap: 8rpx; }
.cal__lgb {
  min-width: 28rpx; height: 28rpx; padding: 0 5rpx; border-radius: 5rpx;
  font-size: 18rpx; line-height: 28rpx; text-align: center; font-weight: 600;
}
.cal__lgb--rest { background: var(--danger-soft); color: var(--danger); }
.cal__lgb--work { background: var(--forest-soft); color: var(--forest-deep); }
.cal__lgb--dot { width: 10rpx; height: 10rpx; min-width: 10rpx; border-radius: 5rpx; background: var(--terracotta); }
.cal__lgt { font-size: 20rpx; color: var(--sub); }
.cal__warn {
  margin-top: 12rpx; font-size: 21rpx; color: var(--warn);
  background: var(--warn-soft); border-radius: 10rpx; padding: 10rpx 16rpx; line-height: 1.5;
}
