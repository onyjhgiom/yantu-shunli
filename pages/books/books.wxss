.page { padding: 20rpx 24rpx 40rpx; }

/* 学科切换 */
.subj-bar { display: flex; gap: 14rpx; overflow-x: auto; padding: 4rpx 0 16rpx; }
.subj { flex: 0 0 auto; display: flex; align-items: center; gap: 10rpx; background: var(--paper-deep); border-radius: 14rpx; padding: 14rpx 22rpx; border: 1rpx solid transparent; }
.subj.on { background: var(--forest-soft); border-color: var(--forest); }
.subj__icon { font-size: 30rpx; color: var(--forest-deep); font-weight: 700; }
.subj__name { font-size: 25rpx; color: var(--ink); }

/* 个性化提示 */
.track-hint { display: flex; align-items: center; gap: 10rpx; background: var(--terracotta-soft); border-radius: 12rpx; padding: 14rpx 18rpx; margin-bottom: 16rpx; }
.track-hint__dot { color: var(--terracotta); font-size: 18rpx; }
.track-hint__txt { font-size: 22rpx; color: var(--terracotta-deep); line-height: 1.5; }

/* 搜索 */
.search-box { margin-bottom: 16rpx; }
.search-box__clear { font-size: 22rpx; color: var(--sub); padding-left: 10rpx; }

/* 考型 chips */
.grades { white-space: nowrap; margin-bottom: 6rpx; }
.grade__chip { display: inline-block; font-size: 24rpx; color: var(--ink); background: var(--paper-deep); border-radius: 20rpx; padding: 10rpx 24rpx; margin-right: 14rpx; }
.grade__chip.on { background: var(--forest); color: #fff; }
.grade__note { display: block; font-size: 20rpx; color: var(--sub); margin: 8rpx 2rpx 16rpx; line-height: 1.5; }

/* 类型筛选 */
.chips { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 18rpx; }
.chip { font-size: 23rpx; color: var(--ink-soft); background: var(--paper-deep); border-radius: 20rpx; padding: 10rpx 22rpx; }
.chip.on { background: var(--forest); color: #fff; }

/* 书目卡 */
.book { background: var(--paper-deep); border-radius: 12rpx; padding: 16rpx 18rpx; margin: 12rpx 0; }
.book__head { display: flex; align-items: center; }
.book__name { font-size: 26rpx; font-weight: 600; color: var(--forest-deep); line-height: 1.4; }
.book__hot { font-size: 18rpx; color: #fff; background: var(--terracotta); border-radius: 12rpx; padding: 2rpx 12rpx; margin-left: 12rpx; flex-shrink: 0; }
.book__tags { margin: 10rpx 0 4rpx; }
.book__tag { font-size: 20rpx; margin-right: 12rpx; }
.book__tag--subj { color: var(--forest-deep); }
.book__tag--type { color: var(--c-english); }
.book__tag--lv { font-weight: 600; }
.book__ver { display: block; font-size: 21rpx; color: var(--sub); line-height: 1.5; }
.book__feat { display: block; font-size: 22rpx; color: var(--ink-soft); line-height: 1.6; margin-top: 6rpx; }

.disc { display: block; font-size: 20rpx; color: var(--sub); line-height: 1.6; margin: 20rpx 4rpx 0; }
