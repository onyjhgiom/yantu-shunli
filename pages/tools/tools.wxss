.hero { margin-bottom: 24rpx; }
.hero__t { font-size: 48rpx; font-weight: 700; color: var(--ink); }
.hero__s { font-size: 24rpx; color: var(--sub); margin-top: 6rpx; }

.group { margin-bottom: 32rpx; }
.group__name { display: block; font-size: 28rpx; font-weight: 600; color: var(--ink-soft); margin-bottom: 16rpx; }

.grid {
  display: flex; flex-wrap: wrap;
  background: var(--card); border: 1rpx solid var(--card-line);
  border-radius: var(--radius-lg); overflow: hidden;
}
.grid__item {
  width: 25%; box-sizing: border-box;
  display: flex; flex-direction: column; align-items: center;
  padding: 30rpx 0; position: relative;
}
.grid__item::after {
  content: ''; position: absolute; right: 0; top: 12rpx; bottom: 12rpx;
  width: 1rpx; background: var(--line);
}
.grid__icon { font-size: 46rpx; }
.grid__label { font-size: 24rpx; color: var(--ink-soft); margin-top: 12rpx; }
