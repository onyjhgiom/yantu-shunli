/* 备考资源中心 · Editorial 主题 */

.res { padding-bottom: 60rpx; }

/* ---------- 顶部栏 ---------- */
.bar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.bar__title { font-size: 44rpx; font-weight: 700; color: var(--ink); display: block; }
.bar__sub { font-size: 24rpx; color: var(--sub); display: block; margin-top: 6rpx; }
.bar__right { padding-top: 8rpx; }

.switch {
  display: inline-flex;
  align-items: center;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 28rpx;
  background: var(--paper-deep);
  border: 1rpx solid var(--line);
}
.switch__dot {
  width: 12rpx; height: 12rpx; border-radius: 6rpx;
  background: var(--sub); margin-right: 10rpx;
}
.switch.on { background: var(--forest-soft); border-color: var(--forest); }
.switch.on .switch__dot { background: var(--forest); }
.switch__t { font-size: 22rpx; color: var(--ink-soft); }
.switch.on .switch__t { color: var(--forest-deep); font-weight: 600; }

/* ---------- 提示条 ---------- */
.tip {
  background: var(--terracotta-soft);
  border: 1rpx solid var(--terracotta-line);
  border-radius: var(--radius);
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.tip__t { font-size: 26rpx; font-weight: 600; color: var(--terracotta); display: block; }
.tip__s { font-size: 23rpx; color: var(--ink-soft); display: block; margin-top: 8rpx; line-height: 1.5; }
.tip__btn { margin-top: 16rpx; }

/* ---------- 搜索 ---------- */
.search-box { margin-bottom: 20rpx; }
.search-box__clear {
  font-size: 36rpx; color: var(--sub); padding: 0 12rpx; line-height: 1;
}
.search-box__btn {
  font-size: 26rpx; color: var(--forest); font-weight: 600; padding-left: 16rpx;
}

/* ---------- 分类 chips ---------- */
.cats { white-space: nowrap; margin: 0 -32rpx 20rpx; padding: 0 32rpx; }
.cats__inner { display: inline-flex; gap: 12rpx; }
.chip {
  display: inline-flex;
  align-items: center;
  height: 60rpx;
  padding: 0 24rpx;
  border-radius: 30rpx;
  background: var(--card);
  border: 1rpx solid var(--card-line);
  font-size: 25rpx;
  color: var(--ink-soft);
}
.chip.on {
  background: var(--forest);
  border-color: var(--forest);
  color: var(--on-primary);
  font-weight: 600;
}

/* ---------- 搜索结果条 ---------- */
.resbar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 4rpx 4rpx 16rpx;
}
.resbar__t { font-size: 24rpx; color: var(--sub); }
.resbar__c { font-size: 24rpx; color: var(--forest); }

/* ---------- 热门 ---------- */
.hot {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.hot:last-child { border-bottom: none; }
.hot__icon {
  width: 60rpx; height: 60rpx; border-radius: 12rpx;
  background: var(--forest-soft); color: var(--forest);
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; margin-right: 20rpx; flex-shrink: 0;
}
.hot__body { flex: 1; min-width: 0; }
.hot__title { font-size: 27rpx; color: var(--ink); display: block; }
.hot__sub {
  font-size: 22rpx; color: var(--sub); display: block; margin-top: 4rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.hot__arrow { font-size: 34rpx; color: var(--sub); margin-left: 12rpx; }

/* ---------- 列表项 ---------- */
.item {
  background: var(--card);
  border: 1rpx solid var(--card-line);
  border-radius: var(--radius-lg);
  padding: 26rpx 28rpx;
  margin-bottom: 16rpx;
}
.item__top { display: flex; align-items: center; margin-bottom: 10rpx; }
.item__cat {
  font-size: 21rpx; color: var(--forest-deep); background: var(--forest-soft);
  padding: 2rpx 14rpx; border-radius: 16rpx;
}
.item__scope {
  font-size: 21rpx; color: var(--sub); margin-left: 12rpx;
  border: 1rpx solid var(--line); padding: 1rpx 12rpx; border-radius: 16rpx;
}
.item__scope--one { color: var(--terracotta); border-color: var(--terracotta-line); background: var(--terracotta-soft); }
.item__fav { margin-left: auto; font-size: 26rpx; color: var(--terracotta); }
.item__title { font-size: 29rpx; font-weight: 600; color: var(--ink); display: block; line-height: 1.45; }
.item__sub { font-size: 23rpx; color: var(--ink-soft); display: block; margin-top: 8rpx; line-height: 1.5; }
.item__foot { display: flex; align-items: center; flex-wrap: wrap; gap: 10rpx; margin-top: 14rpx; }
.item__meta { font-size: 21rpx; color: var(--sub); margin-right: 4rpx; }

/* ---------- 详情弹层 ---------- */
.mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: var(--scrim);
  z-index: 60;
  display: flex; align-items: flex-end;
}
/* 遮罩背景层：吞掉滑动事件，避免手指拖动时背后页面跟着滚 */
.mask__bg {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
}
.sheet {
  position: relative;
  width: 100%;
  /* 必须是确定高度，内部的 flex + scroll-view 才能算出可滚动高度 */
  height: 86vh;
  max-height: 86vh;
  overflow: hidden;
  background: var(--paper);
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex; flex-direction: column;
}
.sheet__head {
  display: flex; align-items: flex-start; justify-content: space-between;
  padding-bottom: 20rpx; border-bottom: 1rpx solid var(--line);
}
.sheet__titlebox { flex: 1; padding-right: 20rpx; }
.sheet__cat { font-size: 22rpx; color: var(--terracotta); display: block; }
.sheet__title { font-size: 34rpx; font-weight: 700; color: var(--ink); display: block; margin-top: 6rpx; line-height: 1.4; }
.sheet__fav { font-size: 40rpx; color: var(--line); line-height: 1; padding: 4rpx; }
.sheet__fav.on { color: var(--terracotta); }
/* min-height: 0 是关键：否则 flex 子项不肯被压缩，scroll-view 会撑高而不滚动 */
.sheet__body { flex: 1; min-height: 0; padding: 20rpx 0; box-sizing: border-box; }
.sheet__sub { font-size: 24rpx; color: var(--ink-soft); display: block; margin-bottom: 14rpx; }
.sheet__tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-bottom: 18rpx; }
.sheet__lines { padding-bottom: 20rpx; }
.sheet__line {
  font-size: 26rpx; color: var(--ink); line-height: 1.72; display: block;
  word-break: break-all;
}
.sheet__line--gap { height: 14rpx; }
.sheet__foot { display: flex; gap: 16rpx; flex-shrink: 0; padding-top: 8rpx; margin-top: 4rpx; border-top: 1rpx solid var(--line); }
.sheet__foot .btn { flex: 1; }
