.seg--sm { display: inline-flex; background: var(--paper-deep); border-radius: 30rpx; padding: 4rpx; }
.seg--sm .seg__item { padding: 10rpx 32rpx; border-radius: 26rpx; font-size: 26rpx; color: var(--ink-soft); }
.seg--sm .seg__item.on { background: var(--forest); color: var(--on-primary); }
.picker { height: 72rpx; display: flex; align-items: center; font-size: 30rpx; color: var(--ink); }

.score { padding: 16rpx 0; }
.score__name { font-size: 28rpx; font-weight: 600; }
.input--right { text-align: right; width: 200rpx; }
.score__sum { text-align: right; font-size: 26rpx; color: var(--forest); font-weight: 600; padding-top: 8rpx; }

.del { margin-top: 20rpx; color: var(--danger); border-color: var(--danger); }
