.seg {
  display: flex;
  background: var(--paper-deep);
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}
.seg__item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: var(--ink-soft);
  padding: 16rpx 0;
  border-radius: 12rpx;
}
.seg__item.on { background: var(--forest); color: var(--on-primary); font-weight: 600; }

.metrics { display: flex; flex-wrap: wrap; }
.metric {
  width: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 18rpx 0;
}
.metric__num { font-size: 44rpx; color: var(--forest); }
.metric__label { font-size: 22rpx; color: var(--sub); margin-top: 6rpx; }
.metrics__foot {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--line);
}

.chart { width: 100%; }
.chart--line { height: 360rpx; }
.chart--bar { height: 320rpx; }

.mastery { padding: 14rpx 0; }
.mastery__top { display: flex; justify-content: space-between; margin-bottom: 10rpx; }
.mastery__name { font-size: 26rpx; font-weight: 600; }
.mastery__val { font-size: 24rpx; color: var(--sub); }

.heat-scroll { width: 100%; }
.heat { display: flex; gap: 8rpx; padding: 8rpx 0; }
.heat__col { display: flex; flex-direction: column; gap: 8rpx; }
.heat__cell {
  width: 26rpx;
  height: 26rpx;
  border-radius: 6rpx;
  background: var(--paper-deep);
}
.heat__legend {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 18rpx;
  justify-content: flex-end;
}
.heat__legend .heat__cell { width: 22rpx; height: 22rpx; }
.heat__stats {
  display: flex;
  justify-content: space-between;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line);
}
