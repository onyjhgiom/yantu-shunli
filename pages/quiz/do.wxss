.top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14rpx; }
.top__tag { font-size: 24rpx; }
.top__prog { font-size: 26rpx; color: var(--sub); }
.prog { height: 8rpx; background: var(--paper-deep); border-radius: 4rpx; overflow: hidden; margin-bottom: 32rpx; }
.prog__fill { height: 100%; background: var(--forest); border-radius: 4rpx; transition: width .2s; }

.q { margin-bottom: 32rpx; }
.q__type {
  display: inline-block; font-size: 22rpx; color: var(--on-fill); background: var(--terracotta);
  border-radius: 8rpx; padding: 4rpx 16rpx; margin-bottom: 16rpx;
}
.q__stem { display: block; font-size: 32rpx; font-weight: 600; color: var(--ink); line-height: 1.55; }

.opts { display: flex; flex-direction: column; gap: 18rpx; }
.o {
  display: flex; align-items: center; padding: 26rpx 28rpx;
  background: var(--card); border: 1rpx solid var(--card-line); border-radius: var(--radius);
}
/* 选中态：用主色 16% 透明底（rgba 拼 alpha，跨浅/深皮肤都清晰可见；
   原先用 --forest-soft，在暗夜金/深海蓝里是深色，叠深色卡片几乎看不见） */
.o.on {
  border-color: var(--forest);
  background: rgba(var(--primary-rgb), 0.16);
  box-shadow: 0 0 0 2rpx var(--forest), 0 6rpx 20rpx rgba(var(--primary-rgb), 0.18);
}
.o.on:active { background: rgba(var(--primary-rgb), 0.24); }
.o:not(.on):active { background: var(--paper-deep); }
.o__mark {
  width: 44rpx; height: 44rpx; border-radius: 22rpx; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  background: var(--paper-deep); color: var(--ink-soft); font-size: 24rpx; margin-right: 18rpx;
}
.o.on .o__mark { background: var(--forest); color: var(--on-primary); }
.o__text { flex: 1; font-size: 29rpx; color: var(--ink); line-height: 1.5; }
.o__check { color: var(--forest); font-size: 32rpx; margin-left: 12rpx; }

.nav { display: flex; gap: 20rpx; margin-top: 40rpx; }
.btn.dis { opacity: .4; }
