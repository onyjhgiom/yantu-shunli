.hero { margin-bottom: 24rpx; }
.hero__t { font-size: 48rpx; font-weight: 700; color: var(--ink); }
.hero__s { font-size: 24rpx; color: var(--sub); margin-top: 6rpx; }

.opts { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 4rpx; }
.opt {
  padding: 14rpx 26rpx; font-size: 26rpx; color: var(--ink-soft);
  background: var(--paper-deep); border-radius: 12rpx; border: 1rpx solid transparent;
}
.opt.on { background: var(--forest); color: var(--on-primary); }

.summary { text-align: center; font-size: 26rpx; color: var(--ink-soft); margin: 8rpx 0 28rpx; }
.btn--lg { height: 92rpx; font-size: 30rpx; }
