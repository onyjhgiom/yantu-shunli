.mood-emoji { display: flex; justify-content: space-between; padding: 8rpx 0 20rpx; }
.me { flex: 1; display: flex; flex-direction: column; align-items: center; opacity: 0.5; }
.me.on { opacity: 1; }
.me__face { font-size: 56rpx; line-height: 1; }
.me__label { font-size: 20rpx; color: var(--ink-soft); margin-top: 8rpx; }
.me.on .me__label { color: var(--forest); font-weight: 600; }

.risk { font-size: 23rpx; color: var(--danger); background: var(--terracotta-soft); border-radius: 10rpx; padding: 14rpx 18rpx; margin: 12rpx 0; line-height: 1.5; }

.curve { width: 100%; height: 160rpx; }

.hi { display: flex; align-items: flex-start; gap: 16rpx; padding: 14rpx 0; border-bottom: 1rpx solid var(--line); }
.hi:last-child { border-bottom: none; }
.hi__emoji { font-size: 40rpx; }
.hi__body { flex: 1; }
.hi__date { font-size: 22rpx; color: var(--sub); display: block; }
.hi__text { font-size: 26rpx; color: var(--ink-soft); display: block; margin-top: 4rpx; line-height: 1.5; }
