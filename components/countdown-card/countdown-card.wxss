.cd {
  background: var(--surface-dark);
  border: none;
  color: var(--on-dark);
  padding: 40rpx 36rpx;
}
.cd__label {
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: rgba(var(--on-dark-rgb), 0.72);
}
.cd__days {
  display: flex;
  align-items: baseline;
  margin-top: 8rpx;
}
.cd__num {
  font-size: 108rpx;
  line-height: 1.05;
  color: var(--on-dark);
  font-weight: 700;
}
.cd__unit {
  font-size: 30rpx;
  margin-left: 12rpx;
  color: rgba(var(--on-dark-rgb), 0.8);
}
.cd__goal {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}
.cd__pin { color: var(--forest); font-size: 22rpx; }
.cd__school {
  font-size: 28rpx;
  color: var(--on-dark);
}
.cd__score {
  font-size: 24rpx;
  color: rgba(var(--on-dark-rgb), 0.75);
  margin-left: auto;
}
.cd__milestones {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(var(--on-dark-rgb), 0.18);
  display: flex;
  gap: 28rpx;
  flex-wrap: wrap;
}
.cd__ms { display: flex; flex-direction: column; }
.cd__ms-label { font-size: 22rpx; color: rgba(var(--on-dark-rgb), 0.62); }
.cd__ms-days { font-size: 28rpx; color: var(--on-dark); font-weight: 600; }
